# Only build/web is served (see vercel.json outputDirectory). Keep the upload
# lean by excluding everything not needed to serve the static web build.
.dart_tool
.idea
android
ios
linux
macos
windows
test
.swagger_tmp
*.iml
# Local build secrets (OAuth client for --dart-define-from-file).
.env*
.flutter-plugins
.flutter-plugins-dependencies

# flutter test leaves a multi-hundred-MB kernel cache under build/; only
# build/web is served, and these tripped Vercel's 100 MB file limit.
build/test_cache
build/*.dill
build/**/*.dill
